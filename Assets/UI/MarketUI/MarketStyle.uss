/* Arka planı hafif şeffaf siyah yapar */
.main-overlay {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
}

/* Laptop ekranı görünümü */
.laptop-screen {
    width: 800px;
    height: 500px;
    background-color: rgb(25, 25, 30);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(80, 80, 100);
    overflow: hidden;
}

/* Üst Başlık */
.header-container {
    height: 50px;
    background-color: rgb(15, 15, 20);
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 20px;
    padding-right: 10px;
    border-bottom-width: 2px;
    border-color: rgb(255, 153, 0); /* Zamazong turuncusu */
}

.header-title {
    color: rgb(255, 153, 0);
    font-size: 20px;
    -unity-font-style: bold;
}

.close-button {
    background-color: rgb(200, 50, 50);
    color: white;
    width: 35px;
    height: 35px;
    border-radius: 5px;
    -unity-font-style: bold;
    border-width: 0;
}

.close-button:hover {
    background-color: rgb(255, 70, 70);
}

/* Orta İçerik */
.content-container {
    flex-grow: 1;
    flex-direction: row;
    padding: 20px;
}

.left-panel {
    flex-grow: 1;
    width: 50%;
    padding-right: 20px;
    border-right-width: 1px;
    border-color: rgb(60, 60, 80);
    justify-content: space-between;
}

.right-panel {
    flex-grow: 1;
    width: 50%;
    padding-left: 20px;
    justify-content: space-between;
}

/* Yazılar */
.panel-title {
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.info-text {
    color: rgb(180, 180, 200);
    font-size: 14px;
    white-space: normal;
}

.cart-container {
    background-color: rgb(15, 15, 20);
    padding: 15px;
    border-radius: 5px;
    margin-top: 20px;
    margin-bottom: 20px;
}

.cart-text {
    color: white;
    font-size: 14px;
}

/* Aksiyon Butonları */
.sell-button {
    background-color: rgb(40, 150, 255);
    color: white;
    height: 50px;
    font-size: 16px;
    -unity-font-style: bold;
    border-radius: 5px;
    border-width: 0;
}

.sell-button:hover {
    background-color: rgb(70, 170, 255);
}

.buy-button {
    background-color: rgb(40, 180, 80);
    color: white;
    height: 50px;
    font-size: 16px;
    -unity-font-style: bold;
    border-radius: 5px;
    border-width: 0;
}

.buy-button:hover {
    background-color: rgb(60, 210, 100);
}
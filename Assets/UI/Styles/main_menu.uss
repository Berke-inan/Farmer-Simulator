/* === ANA KONTEYNER === */
.menu-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: transparent; 
    justify-content: center;
    align-items: flex-start;
}

/* === PANEL YAPISI (SOL YAN PANEL) === */
.menu-panel {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 580px; 
    background-color: rgba(10, 11, 10, 0.96); 
    padding: 0 80px; 
    justify-content: center;
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.05); 
    transition-property: opacity, translate;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-cubic;
    translate: 0 0;
}

.panel-hidden {
    display: none;
    opacity: 0;
    translate: -80px 0;
}

/* === TİPOGRAFİ VE BAŞLIKLAR === */
.kicker-title {
    color: #9ca328; 
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 5px;
}

.title-row {
    flex-direction: row;
    margin-bottom: -15px; 
}

.main-title-w {
    font-size: 85px;
    -unity-font-style: bold;
    color: #eaddcf; 
    letter-spacing: -2px;
}

.main-title-o {
    font-size: 85px;
    -unity-font-style: bold;
    color: #d97706; 
    letter-spacing: -2px;
}

.main-title-second {
    font-size: 85px;
    -unity-font-style: bold;
    color: #eaddcf;
    letter-spacing: -2px;
    margin-bottom: 25px;
}

.subtitle-tags {
    color: #3f473e; 
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    margin-bottom: 80px;
}

/* === BUTONLAR VE LİSTE YAPISI === */
.button-container {
    width: 100%;
    margin-bottom: 40px;
}

.menu-item-btn {
    flex-direction: row;
    align-items: center;
    background-color: transparent;
    border-width: 0;
    margin-bottom: 12px;
    padding: 10px 0;
    cursor: initial;
}

.btn-num {
    color: #353b34; 
    font-size: 20px;
    -unity-font-style: bold;
    width: 40px;
    -unity-text-align: middle-right;
    transition-property: color;
    transition-duration: 0.2s;
}

.btn-divider {
    width: 2px;
    height: 22px;
    background-color: #1a211b; 
    margin: 0 20px;
}

.btn-text {
    color: #636b60; 
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    transition-property: color, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

/* Hover Animasyonları */
.menu-item-btn:hover > .btn-text {
    color: #eaddcf; 
    translate: 10px 0; 
}
.menu-item-btn:hover > .btn-num {
    color: #636b60;
}

/* Çıkış Butonu Özelleştirmesi */
.horizontal-divider {
    height: 1px;
    background-color: #1a211b;
    margin: 20px 0 30px 0;
    width: 80%;
}

.quit-num {
    color: #4a2121;
}
.quit-text {
    color: #8a3434;
}
.menu-item-btn.quit-btn:hover > .quit-text {
    color: #ef4444;
}

/* === ALT BİLGİ (FOOTER) === */
.footer-info {
    flex-direction: row;
    align-items: center;
    position: absolute;
    bottom: 50px;
    left: 80px;
}

.green-dot {
    width: 8px;
    height: 8px;
    background-color: #4ade80;
    border-radius: 4px;
    margin-right: 12px;
}

.footer-text {
    color: #353b34;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

/* === DİĞER ARAYÜZ ELEMANLARI === */
.menu-textfield {
    margin-bottom: 20px;
    width: 80%;
}

.menu-textfield > .unity-text-field__label {
    color: #636b60;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    min-width: 120px;
}

.menu-textfield .unity-text-field__input {
    background-color: transparent;
    border-width: 0 0 2px 0;
    border-color: #353b34;
    color: #d97706;
    font-size: 20px;
    -unity-font-style: bold;
    padding: 5px;
    letter-spacing: 4px;
}

.menu-textfield .unity-text-field__input:focus {
    border-color: #d97706;
}

.info-label {
    color: #eaddcf;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 20px;
}

.credits-scroll {
    max-height: 200px;
    width: 80%;
    margin-bottom: 20px;
}

.credits-text {
    color: #636b60;
    font-size: 14px;
    margin-bottom: 10px;
    letter-spacing: 1px;
}

.highlight {
    color: #d97706;
    -unity-font-style: bold;
}
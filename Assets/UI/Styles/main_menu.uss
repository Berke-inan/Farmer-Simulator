/* Ana Konteyner Ayarları */
.menu-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0); /* Katı renk kalktı, sahne görünecek */
    justify-content: center;
    align-items: center;
    font-size: 14px;
    color: #e2e8f0;
}

/* Evrensel Panel Yapısı */
.menu-panel {
    position: absolute;
    width: 500px;
    padding: 40px;
    background-color: rgba(20, 27, 22, 0.85); /* %85 opaklık, hafif şeffaf */
    border-radius: 12px;
    border-width: 1px;
    border-color: #2e7d32;
    align-items: center;
    transition-property: opacity, scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-cubic;
}

/* State Management Sınıfı: C# tarafından yönetilir */
.panel-hidden {
    display: none;
    opacity: 0;
    scale: 0.95;
}

/* Başlık Stilleri */
.menu-title {
    font-size: 32px;
    -unity-font-style: bold;
    color: #4caf50;
    margin-bottom: 30px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.sub-title {
    font-size: 24px;
    color: #81c784;
}

/* Buton ve Girdi Alanı Kapsayıcısı */
.button-container {
    width: 100%;
    align-items: center;
}

/* Esnek ve Modern Buton Tasarımı */
.menu-button {
    width: 85%;
    height: 46px;
    margin-bottom: 12px;
    background-color: #2e7d32;
    border-color: #1b5e20;
    border-width: 1px;
    border-radius: 6px;
    color: #ffffff;
    font-size: 16px;
    -unity-font-style: bold;
    cursor: initial;
    transition-property: background-color, scale, border-color;
    transition-duration: 0.15s;
}

/* Buton Etkileşim Animasyonları */
.menu-button:hover {
    background-color: #388e3c;
    border-color: #4caf50;
    scale: 1.03;
}

.menu-button:active {
    background-color: #1b5e20;
    scale: 0.98;
}

/* Çıkış ve Geri Butonu Özelleştirmeleri */
.quit-button {
    background-color: #7f1d1d;
    border-color: #991b1b;
    margin-top: 15px;
}

.quit-button:hover {
    background-color: #991b1b;
    border-color: #ef4444;
}

.back-button {
    background-color: #475569;
    border-color: #334155;
    margin-top: 20px;
}

.back-button:hover {
    background-color: #64748b;
    border-color: #94a3b8;
}

/* Dinamik Çok Oyunculu Alanları */
.join-container {
    width: 85%;
    margin-top: 10px;
    padding: 15px;
    background-color: #141b16;
    border-radius: 8px;
    border-width: 1px;
    border-color: #234e26;
}

.menu-textfield {
    margin-bottom: 10px;
}

.menu-textfield > .unity-text-field__label {
    color: #a5d6a7;
    -unity-font-style: bold;
    min-width: 100px;
}

.menu-textfield .unity-text-field__input {
    background-color: #1e2921;
    border-color: #2e7d32;
    color: #ffffff;
    border-radius: 4px;
    padding: 6px;
}

.info-label {
    font-size: 16px;
    color: #ffb74d;
    -unity-font-style: bold;
    margin: 15px 0;
}

/* Ayarlar Altyapısı */
.settings-container {
    width: 90%;
    margin: 20px 0;
}

.menu-slider > .unity-slider__label {
    color: #e2e8f0;
    min-width: 120px;
}

/* Emeği Geçenler Alanı */
.credits-scroll {
    max-height: 200px;
    width: 90%;
    background-color: #141b16;
    padding: 15px;
    border-radius: 8px;
}

.credits-text {
    font-size: 14px;
    margin-bottom: 8px;
    color: #cbd5e1;
}

.highlight {
    color: #ffb74d;
    margin-top: 12px;
}


.copy-button {
    background-color: #0284c7;
    border-color: #0369a1;
    margin-top: 5px;
}
.copy-button:hover {
    background-color: #0369a1;
    border-color: #38bdf8;
}

/* Oyuna Başlama/Tamam Butonu - Canlı Turuncu/Altın Tonları */
.continue-button {
    background-color: #d97706;
    border-color: #b45309;
    margin-top: 15px;
    height: 52px; /* Daha belirgin olması için biraz daha büyük */
}
.continue-button:hover {
    background-color: #b45309;
    border-color: #f59e0b;
    scale: 1.04;
}
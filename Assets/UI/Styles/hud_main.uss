/* === ANA KONTEYNER === */
.hud-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: absolute;
    padding: 40px 50px; 
}

/* === ÜST KISIM (ZAMAN & PARA) === */
.hud-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

/* Tipografik Veri Blokları */
.hud-info-block {
    flex-direction: column;
}

.border-left-accent {
    border-left-width: 4px;
    border-left-color: #d97706; 
    padding-left: 15px;
}

.border-right-accent {
    border-right-width: 4px;
    border-right-color: #9ca328; 
    padding-right: 15px;
    align-items: flex-end;
}

/* Üst Başlıklar (Kicker) */
.hud-kicker {
    color: #9ca328;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 5px;
}

/* Değer Metinleri (Boyutlar 24px'e çekildi) */
.hud-value-primary {
    color: #eaddcf;
    font-size: 24px; 
    -unity-font-style: bold;
    letter-spacing: -1px;
    margin-top: -2px; 
    margin-bottom: 0px;
}

.hud-value-secondary {
    color: #636b60; 
    font-size: 13px; /* Hiyerarşi uyumu için 16px'ten 13px'e düşürüldü */
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.hud-value-orange {
    color: #d97706;
    font-size: 24px; 
    -unity-font-style: bold;
    letter-spacing: -1px;
    margin-top: -2px;
    margin-bottom: 0px;
}

/* === ALT KISIM (SABİT POZİSYONLAMA) === */
.hud-bottom {
    position: absolute;
    bottom: 40px;
    left: 50px;
    right: 50px;
    height: 140px;
}

/* === HOTBAR (ENVANTER) TAM MERKEZDE === */
.hotbar-wrapper {
    position: absolute;
    left: 50%;
    bottom: 0;
    translate: -50% 0; 
    flex-direction: column;
    align-items: center; 
}

.hotbar-container {
    flex-direction: row;
}

.hotbar-divider {
    width: 2px;
    height: 30px;
    background-color: #353b34; 
    margin: 0 8px;
    align-self: center;
}

/* Tek Slot */
.hotbar-slot {
    width: 60px;
    height: 60px;
    background-color: rgba(10, 11, 10, 0.9); 
    margin: 0 3px; 
    border-radius: 0; 
    border-width: 2px;
    border-color: #353b34;
    justify-content: center;
    align-items: center;
    transition-property: scale, border-color, background-color;
    transition-duration: 0.15s;
}

/* Aktif Slot Seçimi */
.hotbar-slot-active {
    border-color: #d97706;
    background-color: rgba(217, 119, 6, 0.1); 
    scale: 1.08;
}

.slot-number {
    position: absolute;
    top: 4px;
    left: 6px;
    font-size: 12px;
    color: #636b60;
    -unity-font-style: bold;
}

.slot-icon {
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
}

.slot-amount {
    position: absolute;
    bottom: 4px;
    right: 6px;
    font-size: 14px;
    color: #eaddcf;
    -unity-font-style: bold;
}

/* === ENERJİ WIDGET EN SAĞ ALT KÖŞEDE === */
.energy-wrapper {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 100px;
    height: 100px;
    flex-direction: column;
    align-items: center;
}

.energy-widget {
    width: 100px; 
    height: 100px;
    justify-content: center;
    align-items: center;
}

.energy-current-circle {
    position: absolute;
    width: 100%;
    height: 100%;
}

.energy-text-container {
    position: absolute;
    top: -4px; 
    left: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.energy-val-main {
    font-size: 26px; 
    color: #eaddcf; 
    -unity-font-style: bold;
    margin-bottom: -4px; 
    -unity-text-align: middle-center;
}

.energy-val-sub {
    font-size: 11px; 
    color: rgba(234, 221, 207, 0.65);
    -unity-font-style: bold;
    letter-spacing: -0.5px; 
    -unity-text-align: middle-center;
}

/* Yazıyı akıştan koparıp sadece görsel olarak aşağı ekler */
.energy-kicker-bottom {
    position: absolute;
    top: 105px; 
    margin: 0;
    -unity-text-align: middle-center;
}
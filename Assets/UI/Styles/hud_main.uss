/* === ANA KONTEYNER === */
.hud-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: absolute;
    padding: 0;
}

/* === ÜST ŞERİT === */
.hud-header {
    position: absolute;
    top: 20px;
    left: 28px;
    right: 28px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

/* Orta gün/sezon rozeti */
.hud-day-badge {
    position: absolute;
    top: 20px;
    left: 0;
    right: 0;
    align-items: center;
    justify-content: center;
}

.hud-day-badge-inner {
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    padding: 4px 14px;
}

.hud-day-text {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.4);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* === PILL (SAAT & PARA ORTAK) === */
.hud-pill {
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 7px 14px;
}

/* Saat pill */
.hud-pill-time {
    border-color: rgba(100, 220, 255, 0.2);
}

.hud-pill-label {
    font-size: 10px;
    color: rgba(126, 232, 250, 0.5);
    -unity-font-style: bold;
    margin-bottom: 1px;
}

.hud-time-text {
    font-size: 18px;
    color: #7ee8fa;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* Para pill */
.hud-pill-money {
    border-color: rgba(255, 210, 80, 0.2);
    align-items: flex-end;
}

.hud-pill-label-money {
    font-size: 10px;
    color: rgba(255, 208, 96, 0.5);
    -unity-font-style: bold;
    margin-bottom: 1px;
    -unity-text-align: upper-right;
}

.hud-money-text {
    font-size: 18px;
    color: #ffd060;
    -unity-font-style: bold;
    -unity-text-align: upper-right;
}

/* === ALT ŞERİT === */
.hud-footer {
    position: absolute;
    bottom: 28px;
    left: 0;
    right: 0;
    justify-content: center;
    align-items: flex-end;
    flex-direction: row;
}

/* === HOTBAR KONTEYNER === */
.hotbar-container {
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 6px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
}

/* Slot ayırıcı (3'lü gruplama için C# ile eklenecek) */
.hotbar-divider {
    width: 1px;
    height: 36px;
    background-color: rgba(255, 255, 255, 0.06);
    margin: 0 2px;
    align-self: center;
}

/* === TEK SLOT === */
.hotbar-slot {
    width: 52px;
    height: 52px;
    background-color: rgba(255, 255, 255, 0.04);
    margin: 0 2px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    justify-content: center;
    align-items: center;
}

/* Slot üst-sol numara */
.slot-number {
    position: absolute;
    top: 3px;
    left: 5px;
    font-size: 9px;
    color: rgba(255, 255, 255, 0.25);
    -unity-font-style: bold;
}

/* Aktif slot */
.hotbar-slot-active {
    border-color: #00e5ff;
    background-color: rgba(0, 229, 255, 0.1);
}

/* İkon */
.slot-icon {
    width: 30px;
    height: 30px;
    max-width: 30px;
    max-height: 30px;
}

/* Adet yazısı */
.slot-amount {
    position: absolute;
    bottom: 3px;
    right: 4px;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.7);
    -unity-font-style: bold;
}

/* === ENERJİ WIDGET TASARIMI === */

.energy-widget {
    margin-left: 12px;
    width: 80px; 
    height: 80px;
    justify-content: center;
    align-items: center;
}

/* GÜNCELLEME: energy-base-ring stili silindi */

/* Çizim alanı */
.energy-current-circle {
    position: absolute;
    width: 100%;
    height: 100%;
}

/* Merkez Metin Konteyneri */
.energy-text-container {
    position: absolute;
    /* GÜNCELLEME: Tam merkeze hizalamak için boşlukları sıfırladık */
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

/* Güncel Enerji (Büyük) */
.energy-text-label {
    font-size: 20px;
    color: #ffffff;
    -unity-font-style: bold;
    /* GÜNCELLEME: Taşmayı önlemek için negatif margin kaldırıldı */
    margin-bottom: 0; 
}

/* Maksimum Enerji (Küçük) */
.energy-max-label {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.5);
    -unity-font-style: bold;
    /* GÜNCELLEME: Taşmayı önlemek için margin sıfırlandı */
    margin-bottom: 0; 
}

/* ENERJİ Yazısı */
.energy-sub-label {
    font-size: 9px;
    color: rgba(255, 255, 255, 0.3);
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    /* GÜNCELLEME: Metinler arası dikey boşluk için azıcık boşluk eklendi */
    margin-top: 2px; 
}
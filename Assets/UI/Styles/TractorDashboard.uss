.dashboard-container {
    position: absolute;
    bottom: 30px;
    left: 30px; /* Paneli tamamen sola çektik */
    width: 350px;
    background-color: rgba(10, 10, 15, 0.9);
    border-radius: 20px;
    padding: 25px;
    border-left-width: 8px; /* Turuncu vurguyu sola aldık */
    border-left-color: #ff9900; 
}
.speed-section {
    flex-direction: row;
    align-items: flex-end;
    justify-content: flex-end;
    margin-bottom: 10px;
}

.speed-number {
    color: #ffffff;
    font-size: 50px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.speed-unit {
    color: #8a8a9d;
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    margin-left: 5px;
}

.divider {
    height: 1px;
    background-color: #2a2a35;
    margin-bottom: 15px;
}

.bar-section {
    margin-bottom: 12px;
}

.bar-title {
    color: #8a8a9d;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 5px;
}

.bar-bg {
    height: 14px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 7px;
    overflow: hidden;
    margin-bottom: 5px;
}

.bar-fill {
    height: 100%;
    width: 100%; 
    border-radius: 5px;
    transition-property: width;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-cubic;
}

.fuel-color {
    background-color: #e68a00; 
}

.condition-color {
    background-color: #2fd159; 
}
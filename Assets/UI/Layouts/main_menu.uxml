<?xml version="1.0" encoding="utf-8"?>
<ui:UXML 
    xmlns:ui="UnityEngine.UIElements" 
    xmlns:uie="UnityEditor.UIElements" 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" 
    editor-extension-mode="False">
    
    <ui:Style src="/Assets/UI/Styles/main_menu.uss" />
    
    <ui:VisualElement name="MenuContainer" class="menu-container">
        
        <ui:VisualElement name="MainMenuPanel" class="menu-panel">
            <ui:Label text="FARMER SIMULATOR" name="MenuTitle" class="menu-title" />
            <ui:VisualElement name="ButtonContainer" class="button-container">
                <ui:Button text="Oyuna Başla" name="PlayButton" class="menu-button" />
                <ui:Button text="Ayarlar" name="SettingsButton" class="menu-button" />
                <ui:Button text="Emeği Geçenler" name="CreditsButton" class="menu-button" />
                <ui:Button text="Oyundan Çık" name="QuitButton" class="menu-button quit-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="MultiplayerPanel" class="menu-panel panel-hidden">
            <ui:Label text="ÇOK OYUNCULU" class="menu-title sub-title" />
            
            <ui:VisualElement name="MultiplayerActions" class="button-container">
                <ui:Button text="Oyun Kur (Host)" name="HostButton" class="menu-button" />
                <ui:Button text="Oyuna Katıl" name="JoinMenuButton" class="menu-button" />
                
                <ui:VisualElement name="JoinContainer" class="join-container panel-hidden">
                    <ui:TextField label="Bağlantı Kodu:" name="RelayCodeField" class="menu-textfield" max-length="6" />
                    <ui:Button text="Bağlan" name="ConnectButton" class="menu-button action-button" />
                </ui:VisualElement>
                
                <ui:Label text="Oyun Kodu: ------" name="RelayCodeLabel" class="info-label panel-hidden" />
                <ui:Button text="Kodu Kopyala" name="CopyCodeButton" class="menu-button copy-button panel-hidden" />
                <ui:Button text="Tamam (Oyuna Başla)" name="ContinueHostButton" class="menu-button continue-button panel-hidden" />
                
                <ui:Button text="Geri" name="MultiplayerBackButton" class="menu-button back-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="SettingsPanel" class="menu-panel panel-hidden">
            <ui:Label text="AYARLAR" class="menu-title sub-title" />
            <ui:VisualElement name="SettingsContainer" class="settings-container">
                <ui:Slider label="Ana Ses Seviyesi" value="75" start-value="0" end-value="100" name="AudioSlider" class="menu-slider" />
            </ui:VisualElement>
            <ui:Button text="Geri" name="SettingsBackButton" class="menu-button back-button" />
        </ui:VisualElement>

        <ui:VisualElement name="CreditsPanel" class="menu-panel panel-hidden">
            <ui:Label text="EMEĞİ GEÇENLER" class="menu-title sub-title" />
            <ui:ScrollView class="credits-scroll">
                <ui:Label text="Berke İnan - Ana Geliştirici &amp; Yazılım Mimarı" class="credits-text" />
                <ui:Label text="Aybek Özman - Proje Ortağı &amp; Tasarım" class="credits-text" />
                <ui:Label text="Unity 6 &amp; Netcode for GameObjects Altyapısı Kullanılmıştır." class="credits-text highlight" />
            </ui:ScrollView>
            <ui:Button text="Geri" name="CreditsBackButton" class="menu-button back-button" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
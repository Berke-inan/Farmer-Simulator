<?xml version="1.0" encoding="utf-8"?>
<ui:UXML 
    xmlns:ui="UnityEngine.UIElements" 
    xmlns:uie="UnityEditor.UIElements" 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" 
    editor-extension-mode="False">
    
    <ui:Style src="/Assets/UI/Styles/main_menu.uss" />
    
    <ui:VisualElement name="MenuContainer" class="menu-container">
        
        <ui:VisualElement name="MainMenuPanel" class="menu-panel panel-hidden">
            <ui:Label text="ÇİFTLİK SİMÜLASYONU" class="kicker-title" />
            <ui:VisualElement class="title-row">
                <ui:Label text="FARM" class="main-title-w" />
                <ui:Label text="ER" class="main-title-o" />
            </ui:VisualElement>
            <ui:Label text="SIM" class="main-title-second" />
            <ui:Label text="TARIM • CO-OP • STRATEJİ" class="subtitle-tags" />
            
            <ui:VisualElement name="ButtonContainer" class="button-container">
                <ui:Button name="PlayButton" class="menu-item-btn">
                    <ui:Label text="01" class="btn-num" picking-mode="Ignore" />
                    <ui:VisualElement class="btn-divider" picking-mode="Ignore" />
                    <ui:Label text="SİMÜLASYONA BAŞLA" class="btn-text" picking-mode="Ignore" />
                </ui:Button>
                
                <ui:Button name="SettingsButton" class="menu-item-btn">
                    <ui:Label text="02" class="btn-num" picking-mode="Ignore" />
                    <ui:VisualElement class="btn-divider" picking-mode="Ignore" />
                    <ui:Label text="SİSTEM AYARLARI" class="btn-text" picking-mode="Ignore" />
                </ui:Button>
                
                <ui:Button name="CreditsButton" class="menu-item-btn">
                    <ui:Label text="03" class="btn-num" picking-mode="Ignore" />
                    <ui:VisualElement class="btn-divider" picking-mode="Ignore" />
                    <ui:Label text="GELİŞTİRİCİ VERİLERİ" class="btn-text" picking-mode="Ignore" />
                </ui:Button>

                <ui:VisualElement class="horizontal-divider" />

                <ui:Button name="QuitButton" class="menu-item-btn quit-btn">
                    <ui:Label text="—" class="btn-num quit-num" picking-mode="Ignore" />
                    <ui:VisualElement class="btn-divider" picking-mode="Ignore" />
                    <ui:Label text="SİSTEMDEN ÇIK" class="btn-text quit-text" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>

            <ui:VisualElement class="footer-info">
                <ui:VisualElement class="green-dot" />
                <ui:Label text="UNITY 6 - BUILD 0.1.0" class="footer-text" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="PausePanel" class="menu-panel panel-hidden">
            <ui:Label text="SİMÜLASYON DURAKLATILDI" class="kicker-title" />
            <ui:VisualElement class="title-row">
                <ui:Label text="PAU" class="main-title-w" />
                <ui:Label text="SE" class="main-title-o" />
            </ui:VisualElement>
            <ui:Label text="CO-OP • SUNUCU AKTİF" class="subtitle-tags" />
            
            <ui:VisualElement class="button-container">
                <ui:Button name="ResumeButton" class="menu-item-btn">
                    <ui:Label text="&gt;" class="btn-num" picking-mode="Ignore" />
                    <ui:VisualElement class="btn-divider" picking-mode="Ignore" />
                    <ui:Label text="SİMÜLASYONA DÖN" class="btn-text" picking-mode="Ignore" />
                </ui:Button>
                
                <ui:Button name="PauseSettingsButton" class="menu-item-btn">
                    <ui:Label text="01" class="btn-num" picking-mode="Ignore" />
                    <ui:VisualElement class="btn-divider" picking-mode="Ignore" />
                    <ui:Label text="SİSTEM AYARLARI" class="btn-text" picking-mode="Ignore" />
                </ui:Button>

                <ui:VisualElement class="horizontal-divider" />

                <ui:Button name="DisconnectRequestButton" class="menu-item-btn quit-btn">
                    <ui:Label text="—" class="btn-num quit-num" picking-mode="Ignore" />
                    <ui:VisualElement class="btn-divider" picking-mode="Ignore" />
                    <ui:Label text="BAĞLANTIYI KES" class="btn-text quit-text" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="ConfirmDisconnectPanel" class="menu-panel panel-hidden">
            <ui:Label text="SİSTEM UYARISI" class="kicker-title" style="color: #ef4444;" />
            <ui:VisualElement class="title-row">
                <ui:Label text="EMİN Mİ" class="main-title-w" />
                <ui:Label text="SİN" class="main-title-o" style="color: #ef4444;" />
            </ui:VisualElement>
            <ui:Label text="KAYDEDİLMEMİŞ VERİLER SİLİNİR" class="subtitle-tags" />
            
            <ui:VisualElement class="button-container">
                <ui:Button name="CancelDisconnectButton" class="menu-item-btn">
                    <ui:Label text="&lt;" class="btn-num" picking-mode="Ignore" />
                    <ui:VisualElement class="btn-divider" picking-mode="Ignore" />
                    <ui:Label text="GERİ DÖN" class="btn-text" picking-mode="Ignore" />
                </ui:Button>

                <ui:VisualElement class="horizontal-divider" />

                <ui:Button name="ConfirmDisconnectButton" class="menu-item-btn quit-btn">
                    <ui:Label text="!" class="btn-num quit-num" picking-mode="Ignore" />
                    <ui:VisualElement class="btn-divider" picking-mode="Ignore" />
                    <ui:Label text="EVET, BAĞLANTIYI KOPAR" class="btn-text quit-text" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="MultiplayerPanel" class="menu-panel panel-hidden">
            <ui:Label text="AĞ BAĞLANTISI" class="kicker-title" />
            <ui:VisualElement class="title-row">
                <ui:Label text="CO-" class="main-title-w" />
                <ui:Label text="OP" class="main-title-o" />
            </ui:VisualElement>
            <ui:Label text="HOST • JOIN • RELAY" class="subtitle-tags" />
            
            <ui:VisualElement name="MultiplayerActions" class="button-container">
                <ui:Button name="HostButton" class="menu-item-btn">
                    <ui:Label text="01" class="btn-num" picking-mode="Ignore" />
                    <ui:VisualElement class="btn-divider" picking-mode="Ignore" />
                    <ui:Label text="OYUN KUR (HOST)" class="btn-text" picking-mode="Ignore" />
                </ui:Button>
                
                <ui:Button name="JoinMenuButton" class="menu-item-btn">
                    <ui:Label text="02" class="btn-num" picking-mode="Ignore" />
                    <ui:VisualElement class="btn-divider" picking-mode="Ignore" />
                    <ui:Label text="OYUNA KATIL" class="btn-text" picking-mode="Ignore" />
                </ui:Button>
                
                <ui:VisualElement name="JoinContainer" class="panel-hidden" style="margin-top: 20px;">
                    <ui:TextField label="AĞ KODU:" name="RelayCodeField" class="menu-textfield" max-length="6" />
                    <ui:Button name="ConnectButton" class="menu-item-btn">
                        <ui:Label text="&gt;" class="btn-num" picking-mode="Ignore" />
                        <ui:VisualElement class="btn-divider" picking-mode="Ignore" />
                        <ui:Label text="BAĞLANTIYI KUR" class="btn-text" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
                
                <ui:Label text="AĞ KODU: ------" name="RelayCodeLabel" class="info-label panel-hidden" />
                
                <ui:Button name="CopyCodeButton" class="menu-item-btn panel-hidden">
                    <ui:Label text="C" class="btn-num" picking-mode="Ignore" />
                    <ui:VisualElement class="btn-divider" picking-mode="Ignore" />
                    <ui:Label text="KODU KOPYALA" class="btn-text" picking-mode="Ignore" />
                </ui:Button>
                
                <ui:Button name="ContinueHostButton" class="menu-item-btn panel-hidden">
                    <ui:Label text="&gt;" class="btn-num" picking-mode="Ignore" />
                    <ui:VisualElement class="btn-divider" picking-mode="Ignore" />
                    <ui:Label text="OPERASYONU BAŞLAT" class="btn-text" picking-mode="Ignore" />
                </ui:Button>

                <ui:VisualElement class="horizontal-divider" />
                
                <ui:Button name="MultiplayerBackButton" class="menu-item-btn quit-btn">
                    <ui:Label text="—" class="btn-num quit-num" picking-mode="Ignore" />
                    <ui:VisualElement class="btn-divider" picking-mode="Ignore" />
                    <ui:Label text="GERİ DÖN" class="btn-text quit-text" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="SettingsPanel" class="menu-panel panel-hidden">
            <ui:Label text="SİSTEM TERCİHLERİ" class="kicker-title" />
            <ui:VisualElement class="title-row">
                <ui:Label text="AYAR" class="main-title-w" />
                <ui:Label text="LAR" class="main-title-o" />
            </ui:VisualElement>
            <ui:Label text="SES • GRAFİK • KONTROL" class="subtitle-tags" />
            
            <ui:VisualElement name="SettingsContainer" class="button-container">
                <ui:Slider label="ANA SES" value="75" start-value="0" end-value="100" name="AudioSlider" class="menu-textfield" />
            </ui:VisualElement>
            
            <ui:VisualElement class="horizontal-divider" />
            
            <ui:Button name="SettingsBackButton" class="menu-item-btn quit-btn">
                <ui:Label text="—" class="btn-num quit-num" picking-mode="Ignore" />
                <ui:VisualElement class="btn-divider" picking-mode="Ignore" />
                <ui:Label text="GERİ DÖN" class="btn-text quit-text" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>

        <ui:VisualElement name="CreditsPanel" class="menu-panel panel-hidden">
            <ui:Label text="PROJE VERİTABANI" class="kicker-title" />
            <ui:VisualElement class="title-row">
                <ui:Label text="KÜN" class="main-title-w" />
                <ui:Label text="YE" class="main-title-o" />
            </ui:VisualElement>
            <ui:Label text="GELİŞTİRİCİ EKİP" class="subtitle-tags" />
            
            <ui:ScrollView class="credits-scroll">
                <ui:Label text="Berke İnan" class="credits-text highlight" />
                <ui:Label text="Aybek Özman" class="credits-text highlight" style="margin-top: 10px;" />
                <ui:Label text="Unity 6 &amp; Netcode for GameObjects" class="credits-text" style="margin-top: 10px;" />
            </ui:ScrollView>

            <ui:VisualElement class="horizontal-divider" />
            
            <ui:Button name="CreditsBackButton" class="menu-item-btn quit-btn">
                <ui:Label text="—" class="btn-num quit-num" picking-mode="Ignore" />
                <ui:VisualElement class="btn-divider" picking-mode="Ignore" />
                <ui:Label text="GERİ DÖN" class="btn-text quit-text" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>